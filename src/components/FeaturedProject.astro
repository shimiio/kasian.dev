---
import { CATEGORY_LABEL } from "../lib/categories";
import { LATEST_STYLE } from "../lib/experiments";
import { homeColour, homeTint, isRunning, type Project, projectAccent, projectUrl } from "../lib/projects";
import Sprite from "./Sprite.astro";

interface Props {
  project: Project;
  [attr: `data-${string}`]: unknown;
}

const { project, ...rest } = Astro.props;
const d = project.data;
// Card colours (neutral without HOME_PROJECT_COLOURS); tint: for the surface,
// the project's background colour if it has one (see backdrop).
const colour = homeColour(project);
const tint = homeTint(project);
const paper = LATEST_STYLE === "paper";

// "paper": light paper card, accents in a darkened site colour.
// "tint": dark glass card tinted with the project's colour (--p).
const c = paper
  ? {
      card: "paper-grain bg-paper text-ink",
      sprite: "bg-paper-deep",
      meta: "text-ink-dim",
      acc: "text-accent-ink",
      blurb: "text-ink-soft",
      link: "group-hover:text-accent-ink",
    }
  : {
      card: "latest-tint",
      sprite: "latest-tint-sprite",
      meta: "text-dim",
      acc: "text-(--p)",
      blurb: "text-fg-soft",
      link: "group-hover:text-(--p)",
    };
---

<a
  {...rest}
  href={projectUrl(project)}
  data-live-accent={projectAccent(project)}
  style={`--p: ${colour}; --p-tint: ${tint}`}
  class:list={["px-corners group flex flex-wrap items-center gap-7 p-7", c.card]}
>
  <div class:list={["px-corners flex size-28 items-center justify-center [--px:4px]", c.sprite]}>
    <Sprite src={d.sprite} size={84} />
  </div>
  <div class="flex min-w-0 flex-[1_1_340px] flex-col gap-2">
    <div class:list={["flex flex-wrap items-baseline gap-x-3.5 gap-y-1 text-xs", c.meta]}>
      <span class:list={["font-bold", c.acc]}>{CATEGORY_LABEL[d.category]}</span>
      <span>
        {isRunning(project) && <span data-spinner class:list={["spinner", c.acc]} aria-hidden="true">⠋</span>}
        {d.status}
      </span>
      <span>{d.stack.join(" · ")}</span>
    </div>
    <span class="font-pixel text-[34px] leading-[1.05] font-bold">{d.title}</span>
    <span class={c.blurb}>{d.blurb}</span>
    <span class:list={["text-[13px] font-bold underline underline-offset-4", c.link]}>
      read the story →
    </span>
  </div>
</a>
