---
import { CATEGORY_LABEL } from "../lib/categories";
import { type Project, projectAccent, projectUrl } from "../lib/projects";
import Sprite from "./Sprite.astro";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const d = project.data;
---

<a
  href={projectUrl(project)}
  data-live-accent={projectAccent(project)}
  class="px-corners paper-grain group flex flex-wrap items-center gap-7 bg-paper p-7 text-ink"
>
  <div class="px-corners flex size-28 items-center justify-center bg-paper-deep [--px:4px]">
    <Sprite src={d.sprite} size={84} />
  </div>
  <div class="flex min-w-0 flex-[1_1_340px] flex-col gap-2">
    <div class="flex flex-wrap items-baseline gap-x-3.5 gap-y-1 text-xs text-ink-dim">
      <span class="font-bold text-accent-ink">{CATEGORY_LABEL[d.category]}</span>
      <span>{d.status}</span>
      <span>{d.stack.join(" · ")}</span>
    </div>
    <span class="font-pixel text-[34px] leading-[1.05] font-bold">{d.title}</span>
    <span class="text-ink-soft">{d.blurb}</span>
    <span class="text-[13px] font-bold underline underline-offset-4 group-hover:text-accent-ink">
      read the story →
    </span>
  </div>
</a>
