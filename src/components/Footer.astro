---
import { getCollection } from "astro:content";
import { external, LINKS, SITE } from "../config";
import { getProjects, homeColour, plural, projectAccent, projectUrl } from "../lib/projects";
import Sprite from "./Sprite.astro";

const projects = await getProjects();
// Vim keys hint (see scripts/vim-keys.ts): h and n only mean something on a project page.
const onProject = Astro.url.pathname.startsWith("/projects/");
const ideas = await getCollection("ideas");

const links = [
  { label: "github", href: LINKS.github },
  { label: "linkedin", href: LINKS.linkedin },
  // A bare address works too: it becomes a mailto: link.
  { label: "email", href: LINKS.email && !LINKS.email.includes(":") ? `mailto:${LINKS.email}` : LINKS.email },
  { label: "cv.pdf", href: LINKS.cv },
].filter((l) => l.href);
---

<footer class="flex flex-col gap-8 border-t border-line pt-6 text-[13px] text-dim">
  <!-- The "collection": grows by one sprite with every project. -->
  <div class="flex flex-col gap-2.5">
    <span class="note text-xs">
      collected so far: {plural(projects.length, "project")}, {plural(ideas.length, "idea")}
    </span>
    <div class="flex flex-wrap gap-2">
      {
        projects.map((p) => (
          <a
            href={projectUrl(p)}
            aria-label={p.data.title}
            title={p.data.title}
            data-live-accent={projectAccent(p)}
            style={`--tile: ${homeColour(p)}`}
            class="tile px-corners flex size-12 items-center justify-center [--px:3px]"
          >
            <Sprite src={p.data.sprite} size={24} />
          </a>
        ))
      }
      {
        ideas.map((idea) => (
          <a
            href="/#ideas"
            aria-label={`idea: ${idea.data.title}`}
            title="idea"
            class="tile px-corners flex size-12 items-center justify-center [--px:3px]"
          >
            <Sprite src="/sprites/idea.svg" size={24} dim />
          </a>
        ))
      }
      <div aria-hidden="true" class="size-12 border border-dashed border-line-strong"></div>
    </div>
  </div>

  <div class="flex flex-wrap justify-between gap-4">
    <div class="flex flex-wrap gap-5">
      {links.map((l) => <a href={l.href} {...external(l.href)} class="hover:text-accent">{l.label}</a>)}
    </div>
    <span class="vim-hint" aria-hidden="true">
      j/k move · enter open{onProject && " · n next · h back"}
    </span>
    <span>{SITE.location}</span>
  </div>
</footer>
