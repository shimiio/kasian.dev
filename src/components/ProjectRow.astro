---
import { CATEGORY_LABEL } from "../lib/categories";
import { ROW_HOVER, SITE_ACCENT_STYLE } from "../lib/experiments";
import { isRunning, type Project, projectAccent, projectUrl, spriteTransition } from "../lib/projects";
import Sprite from "./Sprite.astro";

interface Props {
  project: Project;
  [attr: `data-${string}`]: unknown;
}

const { project, ...rest } = Astro.props;
const d = project.data;
const colour = projectAccent(project);
// Neutral site colour: the row's category and spinner take the project's own
// colour (--row-p), like projects in kel's sidebar.
const rowStyle =
  SITE_ACCENT_STYLE === "neutral"
    ? `--row-p: ${colour}; --row-p-ink: color-mix(in oklab, ${colour} 45%, #000);`
    : undefined;
---

<a
  {...rest}
  href={projectUrl(project)}
  data-category={d.category}
  data-live-accent={colour}
  style={rowStyle}
  class:list={[ROW_HOVER === "tint" && "row-tint"]}
  class="row grid grid-cols-[48px_minmax(0,1fr)] items-start gap-x-4 gap-y-2 border-b border-line px-3 py-5 sm:grid-cols-[48px_minmax(0,1fr)_auto] sm:gap-5 sm:px-4"
>
  <Sprite src={d.sprite} size={48} transition={spriteTransition(project)} class="mt-0.5" />
  <div class="flex min-w-0 flex-col gap-1">
    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
      <span class="text-[17px] font-bold">{d.title}</span>
      <span class="text-xs text-(--row-dim)">{d.stack.join(" · ")}</span>
    </div>
    <span class="text-(--row-muted)">{d.blurb}</span>
  </div>
  <!-- Phones: category and status go on a line under the text, so the blurb
       keeps the full width. Wider: their own column on the right. -->
  <div
    class="col-start-2 flex flex-wrap gap-x-3 text-xs whitespace-nowrap sm:col-start-3 sm:row-start-1 sm:flex-col sm:items-end sm:gap-1"
  >
    <span class="text-(--row-acc)">{CATEGORY_LABEL[d.category]}</span>
    <span class="text-(--row-dim)">
      {isRunning(project) && <span data-spinner class="spinner text-(--row-acc)" aria-hidden="true">⠋</span>}
      {d.status}
    </span>
  </div>
</a>
