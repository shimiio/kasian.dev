---
/**
 * A screenshot or a short clip in a project story, wider than the text.
 * In MDX (no import needed):
 *
 *   <Shot src="/media/kel/settings.mp4" alt="…" caption="…" />
 *
 * A clip (.mp4) waits on its poster (the .webp next to it with the same name,
 * first frame) with a small "▶ play" mark, and plays muted on a loop while
 * the mouse is over it, so the clips don't pull the eye from the text. With
 * `autoplay` (the teaser at the top) it plays like a GIF while on screen.
 * With reduced motion every clip waits on the poster, with controls.
 *
 * A click opens it at full size over the page (Esc, a click or the button
 * closes it); a clip goes on from the same moment.
 */
interface Props {
  /** Path under public/: an image, or an .mp4 clip. */
  src: string;
  /** What it shows, for screen readers. */
  alt: string;
  /** Short line under it. */
  caption?: string;
  width?: number;
  height?: number;
  /** A clip plays by itself while on screen, instead of on hover. */
  autoplay?: boolean;
}

const { src, alt, caption, width = 1280, height = 720, autoplay = false } = Astro.props;
const clip = src.endsWith(".mp4");
const poster = clip ? src.replace(/\.mp4$/, ".webp") : undefined;
---

<figure class="shot">
  <button
    type="button"
    class="shot-frame px-corners"
    data-hover-play={clip && !autoplay ? "" : undefined}
    aria-label={`Open full size: ${alt}`}
  >
    {
      clip ? (
        <video
          data-shot-clip={autoplay ? "auto" : "hover"}
          src={src}
          poster={poster}
          width={width}
          height={height}
          muted
          loop
          playsinline
          preload="metadata"
          aria-label={alt}
        />
      ) : (
        <img src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
      )
    }
    {clip && !autoplay && (
      <span class="shot-play" aria-hidden="true">
        ▶ play
      </span>
    )}
  </button>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
  // The teaser plays only while on screen (no CPU spent once scrolled away);
  // the other clips play while hovered. With reduced motion they all stay on
  // the poster and get controls instead.
  const reduced = matchMedia("(prefers-reduced-motion: reduce)");
  let observer: IntersectionObserver | undefined;

  const setup = () => {
    observer?.disconnect();
    const clips = document.querySelectorAll<HTMLVideoElement>("video[data-shot-clip]");
    if (reduced.matches) {
      clips.forEach((v) => (v.controls = true));
      return;
    }
    const auto = document.querySelectorAll<HTMLVideoElement>('video[data-shot-clip="auto"]');
    observer = new IntersectionObserver(
      (entries) =>
        entries.forEach(({ target, isIntersecting }) => {
          const v = target as HTMLVideoElement;
          if (isIntersecting) v.play().catch(() => (v.controls = true));
          else v.pause();
        }),
      { threshold: 0.3 },
    );
    auto.forEach((v) => observer!.observe(v));
  };

  // Hover to play, leave to pause (where it stopped).
  const hoverClip = (e: Event) => {
    const frame = (e.target as Element).closest?.<HTMLElement>("[data-hover-play]");
    const video = frame?.querySelector("video");
    if (!frame || !video || reduced.matches) return;
    if (e.type === "pointerenter") {
      video.play().then(() => (frame.dataset.playing = "")).catch(() => {});
    } else {
      video.pause();
      delete frame.dataset.playing;
    }
  };
  document.addEventListener("pointerenter", hoverClip, true);
  document.addEventListener("pointerleave", hoverClip, true);

  document.addEventListener("astro:page-load", setup);

  // Full size: one <dialog> per page, made on first use.
  const open = (frame: HTMLElement) => {
    const media = frame.querySelector<HTMLImageElement | HTMLVideoElement>("img, video");
    if (!media) return;
    let dialog = document.querySelector<HTMLDialogElement>("dialog.shot-zoom");
    if (!dialog) {
      dialog = document.createElement("dialog");
      dialog.className = "shot-zoom";
      dialog.addEventListener("click", () => dialog!.close());
      dialog.addEventListener("close", () => dialog!.replaceChildren());
      document.body.append(dialog);
    }
    const copy = media.cloneNode() as HTMLImageElement | HTMLVideoElement;
    copy.removeAttribute("data-shot-clip");
    copy.removeAttribute("loading");
    if (copy instanceof HTMLVideoElement && media instanceof HTMLVideoElement) {
      copy.muted = true;
      copy.currentTime = media.currentTime;
      if (reduced.matches) copy.controls = true;
      else copy.play().catch(() => (copy.controls = true));
      // Controls take clicks themselves; anywhere else closes.
      copy.addEventListener("click", (e) => copy.controls && e.stopPropagation());
    }
    const close = document.createElement("span");
    close.className = "shot-zoom-close";
    close.textContent = "esc ✕";
    dialog.replaceChildren(copy, close);
    dialog.showModal();
  };

  document.addEventListener("click", (e) => {
    const frame = (e.target as Element).closest?.<HTMLElement>(".shot-frame");
    if (frame) open(frame);
  });
</script>
