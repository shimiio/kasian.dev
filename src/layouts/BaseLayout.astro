---
import "@fontsource-variable/jetbrains-mono";
import "@fontsource-variable/inter";
import "@fontsource/silkscreen/400.css";
import "@fontsource/silkscreen/700.css";
import "../styles/global.css";

import { ClientRouter } from "astro:transitions";

import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE } from "../config";
import { SITE_ACCENT } from "../lib/projects";

interface Props {
  title?: string;
  description?: string;
  /** Page colour (a project's accent). Defaults to the site accent. */
  accent?: string;
}

const { title, description = SITE.description, accent } = Astro.props;
const pageAccent = accent ?? SITE_ACCENT;
// On a project page its colour becomes the accent; accent-ink (accent text
// on paper) is a darkened version of it.
const accentStyle = accent
  ? `--color-accent: ${accent}; --color-accent-ink: color-mix(in oklab, ${accent} 45%, #000);`
  : undefined;
// Background experiment: "pixels" = low-res dithered colour field (canvas),
// "soft" = blurred CSS blobs.
const BACKGROUND: "pixels" | "soft" = "pixels";

const fullTitle = title ? `${title} · ${SITE.domain}` : `${SITE.name} · ${SITE.domain}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" data-accent={pageAccent} style={accentStyle}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#0c0c0e" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="generator" content={Astro.generator} />
    <!-- In-page navigation: links swap the page without a full reload, with
         view transitions in every browser that has them (Firefox too). -->
    <ClientRouter />
    <!-- First load only: start the live colour at this page's accent. -->
    <script is:inline>
      document.documentElement.style.setProperty(
        "--live-accent",
        document.documentElement.dataset.accent,
      );
    </script>
  </head>
  <body>
    <!-- Persisted across navigations: the background keeps moving and only
         its colour changes. -->
    <div class="backdrop" aria-hidden="true" transition:persist="backdrop">
      {
        BACKGROUND === "pixels" ? (
          <canvas class="pixel-field" />
        ) : (
          <>
            <span />
            <span />
            <span />
          </>
        )
      }
    </div>
    <script is:inline>
      // Drift phase from the wall clock (soft variant), set once on first load.
      document.currentScript.previousElementSibling.style.setProperty(
        "--drift-t",
        `-${(Date.now() / 1000) % 3600}s`,
      );
    </script>
    <div class="glass mx-auto flex min-h-dvh max-w-[820px] flex-col gap-18 px-6 pt-10 pb-16">
      <Header />
      <main>
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>

<script>
  import "../scripts/pixel-field";

  // --live-accent = colour of the current page, or of the project under the
  // pointer / focus (rows, the latest card, footer tiles, "next" link), like
  // switching projects in kel's sidebar. It is a registered <color> with a CSS
  // transition, so every change fades.
  const root = document.documentElement;
  const setLive = (color?: string) => {
    if (color) root.style.setProperty("--live-accent", color);
  };
  const pageAccent = () => root.dataset.accent;
  const previewOf = (target: EventTarget | null) =>
    target instanceof Element ? target.closest<HTMLElement>("[data-live-accent]") : null;

  // Delegated on document, so it keeps working after page swaps.
  const enter = (e: Event) => setLive(previewOf(e.target)?.dataset.liveAccent);
  const leave = (e: Event) => {
    const from = previewOf(e.target);
    const to = previewOf((e as PointerEvent | FocusEvent).relatedTarget);
    if (from && from !== to) setLive(to?.dataset.liveAccent ?? pageAccent());
  };
  document.addEventListener("pointerover", enter);
  document.addEventListener("pointerout", leave);
  document.addEventListener("focusin", enter);
  document.addEventListener("focusout", leave);

  // After a page swap <html> gets the new page's attributes (which wipes the
  // inline --live-accent): set it again right away, before the next frame, so
  // the colour fades from where it was instead of jumping.
  document.addEventListener("astro:after-swap", () => setLive(pageAccent()));
</script>
