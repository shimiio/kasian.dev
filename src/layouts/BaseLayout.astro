---
import "@fontsource-variable/jetbrains-mono";
import "@fontsource-variable/inter";
import "@fontsource/silkscreen/400.css";
import "@fontsource/silkscreen/700.css";
import "../styles/global.css";

import { ClientRouter } from "astro:transitions";

import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE } from "../config";
import { arrowCursor, handCursor } from "../lib/cursors";
import { getProjects, projectAccent, SITE_ACCENT, SITE_BACKDROP } from "../lib/projects";

interface Props {
  title?: string;
  description?: string;
  /** Page colour (a project's accent). Defaults to the site accent. */
  accent?: string;
}

const { title, description = SITE.description, accent } = Astro.props;
const pageAccent = accent ?? SITE_ACCENT;
const projects = await getProjects();

// Background field colours (space-separated list). On a project page: its
// colour. Elsewhere, experiment: "mix" = every project's colour, one per blob
// (entering a project, they all turn into its colour); "grey" = near-neutral.
const HOME_BACKDROP: "mix" | "grey" = "mix";
const projectColours = [...new Set(projects.flatMap((p) => p.data.accent ?? []))];
const pageBackdrop =
  accent ??
  (HOME_BACKDROP === "mix" && projectColours.length ? projectColours.join(" ") : SITE_BACKDROP);
// On a project page its colour becomes the accent; accent-ink (accent text
// on paper) is a darkened version of it.
const accentStyle = accent
  ? `--color-accent: ${accent}; --color-accent-ink: color-mix(in oklab, ${accent} 45%, #000);`
  : undefined;
// Background experiment: "pixels" = low-res dithered colour field (canvas),
// "soft" = blurred CSS blobs.
const BACKGROUND: "pixels" | "soft" = "pixels";

// Experiment: pixel mouse cursors. A neutral arrow and hand everywhere; over a
// project (anything with data-live-accent) the hand takes the project's colour.
const CUSTOM_CURSOR = true;
const cursorCss = await (async () => {
  if (!CUSTOM_CURSOR) return "";
  const accents = [...new Set([SITE_ACCENT, ...projects.map(projectAccent)])];
  const neutral = "#e8e6e3";
  return [
    `:root{--cursor-arrow:${arrowCursor(neutral)};--cursor-hand:${handCursor(neutral)}}`,
    ...accents.map((c) => `[data-live-accent="${c}"]{cursor:${handCursor(c)}}`),
  ].join(" ");
})();

const fullTitle = title ? `${title} · ${SITE.domain}` : `${SITE.name} · ${SITE.domain}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" data-accent={pageAccent} data-backdrop={pageBackdrop} style={accentStyle}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#0c0c0e" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="generator" content={Astro.generator} />
    <!-- In-page navigation: links swap the page without a full reload, with
         view transitions in every browser that has them (Firefox too). -->
    <ClientRouter />
    <!-- First load only: start the background at this page's colour. -->
    <script is:inline>
      document.documentElement.style.setProperty(
        "--live-accent",
        document.documentElement.dataset.backdrop.split(" ")[0],
      );
    </script>
    {cursorCss && <style is:inline set:html={cursorCss} />}
  </head>
  <body>
    <!-- Persisted across navigations: the background keeps moving and only
         its colour changes. -->
    <div class="backdrop" aria-hidden="true" transition:persist="backdrop">
      {
        BACKGROUND === "pixels" ? (
          <canvas class="pixel-field" />
        ) : (
          <>
            <span />
            <span />
            <span />
          </>
        )
      }
    </div>
    <script is:inline>
      // Drift phase from the wall clock (soft variant), set once on first load.
      document.currentScript.previousElementSibling.style.setProperty(
        "--drift-t",
        `-${(Date.now() / 1000) % 3600}s`,
      );
    </script>
    <div class="glass window mx-auto flex min-h-dvh max-w-[960px] flex-col gap-18 px-5 pt-10 sm:px-6 pb-16">
      <Header />
      <main>
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>

<script>
  import "../scripts/pixel-field";

  // --live-accent (a registered <color> with a CSS transition; used by the
  // "soft" background) follows the page's first backdrop colour. After a page
  // swap <html> gets the new page's attributes, which wipes the inline value:
  // set it again right away, so it fades from where it was. The pixel field
  // reads data-backdrop itself and fades its colours in JS.
  const root = document.documentElement;
  document.addEventListener("astro:after-swap", () => {
    root.style.setProperty("--live-accent", (root.dataset.backdrop ?? "").split(" ")[0]);
  });
</script>
