---
import "@fontsource-variable/jetbrains-mono";
import "@fontsource-variable/inter";
import "@fontsource/silkscreen/400.css";
import "@fontsource/silkscreen/700.css";
// The same files, requested early (see the preload links in <head>): the
// pixel font and the main text font are then in place at the first paint,
// instead of the page drawing in a fallback font and jumping when they load.
import pixelBold from "@fontsource/silkscreen/files/silkscreen-latin-700-normal.woff2?url";
import pixelRegular from "@fontsource/silkscreen/files/silkscreen-latin-400-normal.woff2?url";
import monoLatin from "@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url";
import "../styles/global.css";

import { ClientRouter } from "astro:transitions";

import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE } from "../config";
import { arrowCursor, handCursor } from "../lib/cursors";
import { SITE_BACKDROP } from "../lib/projects";

interface Props {
  title?: string;
  description?: string;
  /** Page colour (a project's accent). Defaults to the site accent. */
  accent?: string;
  /** Background colour, if not the accent (a project's backdrop). */
  backdrop?: string;
  /** Boot animation on this page (see src/scripts/boot.ts). */
  boot?: "home" | "project";
  /** Link preview image (see src/pages/og); the site's by default. */
  ogImage?: string;
  /** Keep the page out of search results (the 404). */
  noindex?: boolean;
}

const { title, description = SITE.description, accent, backdrop, boot, ogImage = "/og/index.png", noindex = false } = Astro.props;
// Background field colour: on a project page its backdrop (or accent), else
// a near-neutral grey.
const pageBackdrop = backdrop ?? accent ?? SITE_BACKDROP;
// On a project page its colour becomes the accent (elsewhere it is off-white,
// see global.css).
const accentStyle = accent ? `--color-accent: ${accent};` : undefined;

// Pixel mouse cursors: a neutral arrow and hand (src/lib/cursors.ts).
const neutral = "#e8e6e3";
const cursorCss = `:root{--cursor-arrow:${arrowCursor(neutral)};--cursor-hand:${handCursor(neutral)}}`;

const fullTitle = title ? `${title} · ${SITE.domain}` : `${SITE.name} · ${SITE.domain}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" data-boot={boot} data-backdrop={pageBackdrop} style={accentStyle}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {
      [pixelBold, pixelRegular, monoLatin].map((href) => (
        <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />
      ))
    }
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#0c0c0e" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={fullTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <!-- In-page navigation: links swap the page without a full reload, with
         view transitions in every browser that has them (Firefox too). -->
    <ClientRouter />
    <!-- Boot animation gate (see src/scripts/boot.ts): adds html.booting before
         the page is painted, so the hidden parts never flash. On first load
         right here; after an in-page navigation on astro:after-swap, which
         runs before the new page is shown. Once per page per session; ?boot
         replays, ?boot=5 plays 5x slower. -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        let safety = 0;
        const gate = () => {
          clearTimeout(safety);
          if (!root.dataset.boot) return;
          const params = new URLSearchParams(location.search);
          if (!params.has("boot") && sessionStorage.getItem("booted:" + location.pathname)) return;
          if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
          root.classList.add("booting");
          const slow = Number(params.get("boot")) || 1;
          safety = setTimeout(() => root.classList.remove("booting"), 8000 * slow);
        };
        gate();
        document.addEventListener("astro:after-swap", gate);
      })();
    </script>
    <style is:inline set:html={cursorCss} />
  </head>
  <body>
    <!-- Persisted across navigations: the background keeps moving and only
         its colour changes. -->
    <div class="backdrop" aria-hidden="true" transition:persist="backdrop">
      <canvas class="pixel-field"></canvas>
    </div>
    <div class="glass window mx-auto flex min-h-dvh max-w-[960px] flex-col gap-18 px-5 pt-10 sm:px-6 pb-16">
      <Header />
      <main>
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>

<script>
  import "../scripts/boot";
  import "../scripts/pixel-field";
  import "../scripts/spinners";
  import "../scripts/vim-keys";
</script>
