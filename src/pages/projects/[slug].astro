---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import Heading from "../../components/Heading.astro";
import Link from "../../components/Link.astro";
import Shot from "../../components/Shot.astro";
import Sprite from "../../components/Sprite.astro";
import StatusMark from "../../components/StatusMark.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { external } from "../../config";
import { CATEGORY_LABEL } from "../../lib/categories";
import {
  getProjects,
  type Project,
  projectAccent,
  projectUrl,
  projectWhen,
  spriteTransition,
} from "../../lib/projects";

export const getStaticPaths = (async () => {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      next: projects.length > 1 ? projects[(i + 1) % projects.length] : undefined,
    },
  }));
}) satisfies GetStaticPaths;

interface Props {
  project: Project;
  next?: Project;
}

const { project, next } = Astro.props;
const { Content } = await render(project);
const d = project.data;

// Under the title: the tl;dr, or the tagline without one (the tagline stays
// the page description).
const intro = d.tldr ?? d.tagline;

const meta: { key: string; value: string; accent?: boolean; status?: boolean }[] = [
  { key: "type", value: CATEGORY_LABEL[d.category], accent: true },
  { key: "status", value: d.status, status: true },
  { key: "when", value: projectWhen(project) },
  ...(d.platform ? [{ key: "platform", value: d.platform }] : []),
  { key: "stack", value: d.stack.join(" · ") },
  ...(d.builtWith ? [{ key: "built with", value: d.builtWith }] : []),
];

const links = (["live", "github", "readme"] as const)
  .filter((k) => d.links[k])
  .map((k) => ({ label: k, href: d.links[k]! }));
---

<BaseLayout title={d.title} description={d.tagline} accent={d.accent} backdrop={d.backdrop} boot="project" ogImage={`/og/${project.id}.png`}>
  <div class="flex flex-col gap-12">
    <section class="flex flex-col gap-7">
      <a href="/#projects" class="text-[13px] text-dim hover:text-accent">← projects/</a>
      <div class="flex flex-wrap items-center gap-7">
        <div class="px-corners flex size-40 items-center justify-center bg-surface">
          <Sprite src={d.sprite} size={120} alt={`${d.title} sprite`} transition={spriteTransition(project)} />
        </div>
        <div class="flex min-w-0 flex-[1_1_320px] flex-col gap-2.5">
          <h1 data-boot-text="char" class="font-pixel text-[56px] leading-none font-bold">
            {d.title}<span class="cursor text-accent" aria-hidden="true"></span>
          </h1>
        </div>
      </div>
      <p data-boot-text="word" class="lead max-w-[680px] font-sans text-[19px] leading-relaxed text-fg">{intro}</p>
    </section>

    <!-- Each row is a subgrid, so the boot animation prints it as one line. -->
    <dl
      data-boot-section
      data-boot-label="meta/"
      class="grid grid-cols-[110px_minmax(0,1fr)] gap-x-5 gap-y-2 border-y border-line py-5 text-[13px]"
    >
      {
        meta.map((m) => (
          <div data-boot-item class="col-span-2 grid grid-cols-subgrid">
            <dt class="text-dim">{m.key}</dt>
            <dd class:list={[m.accent && "text-accent"]}>
              {m.status ? <StatusMark project={project} markClass="text-accent" full /> : m.value}
            </dd>
          </div>
        ))
      }
      {
        links.length > 0 && (
          <div data-boot-item class="col-span-2 grid grid-cols-subgrid">
            <dt class="text-dim">links</dt>
            <dd class="flex flex-wrap gap-4">
              {links.map((l) => (
                <a href={l.href} {...external(l.href)} class="underline underline-offset-3 hover:text-accent">
                  {l.label}
                </a>
              ))}
            </dd>
          </div>
        )
      }
    </dl>

    <article data-boot-section="children" data-boot-label="story/" class="story">
      <Content components={{ Shot, h2: Heading, a: Link }} />
    </article>

    <nav class="flex flex-wrap justify-between gap-4 border-t border-line pt-6 text-[13px]">
      <a href="/#projects" data-vim-back class="text-dim hover:text-accent">← all projects</a>
      {
        next && (
          <a
            href={projectUrl(next)}
            data-vim-next
            class="hover:text-accent"
          >
            next: {next.data.title} →
          </a>
        )
      }
    </nav>
  </div>
</BaseLayout>
