---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import Sprite from "../../components/Sprite.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { CATEGORY_LABEL } from "../../lib/categories";
import {
  getProjects,
  type Project,
  projectAccent,
  projectUrl,
  spriteTransition,
} from "../../lib/projects";

export const getStaticPaths = (async () => {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      next: projects.length > 1 ? projects[(i + 1) % projects.length] : undefined,
    },
  }));
}) satisfies GetStaticPaths;

interface Props {
  project: Project;
  next?: Project;
}

const { project, next } = Astro.props;
const { Content } = await render(project);
const d = project.data;

// Experiment toggle: put the whole story on a paper sheet instead of the dark page.
const STORY_ON_PAPER = false;

const meta: { key: string; value: string; accent?: boolean }[] = [
  { key: "type", value: CATEGORY_LABEL[d.category], accent: true },
  { key: "status", value: d.status },
  ...(d.platform ? [{ key: "platform", value: d.platform }] : []),
  { key: "stack", value: d.stack.join(" · ") },
  ...(d.builtWith ? [{ key: "built with", value: d.builtWith }] : []),
];

const links = (["live", "github", "readme"] as const)
  .filter((k) => d.links[k])
  .map((k) => ({ label: k, href: d.links[k]! }));
---

<BaseLayout title={d.title} description={d.tagline} accent={d.accent} backdrop={d.backdrop}>
  <div class="flex flex-col gap-12">
    <section class="flex flex-col gap-7">
      <a href="/#projects" class="text-[13px] text-dim hover:text-accent">← projects/</a>
      <div class="flex flex-wrap items-center gap-7">
        <div class="px-corners flex size-32 items-center justify-center bg-surface">
          <Sprite src={d.sprite} size={96} alt={`${d.title} sprite`} transition={spriteTransition(project)} />
        </div>
        <div class="flex min-w-0 flex-[1_1_320px] flex-col gap-2.5">
          <h1 class="font-pixel text-[56px] leading-none font-bold">
            {d.title}<span class="cursor text-accent" aria-hidden="true"></span>
          </h1>
          <p class="text-fg-soft">{d.tagline}</p>
        </div>
      </div>
    </section>

    {
      d.tldr && (
        <div class="px-corners paper-grain flex flex-col gap-2 bg-paper px-7 py-6 text-ink">
          <span class="text-xs font-bold text-accent-ink">tl;dr</span>
          <p class="font-sans text-lg leading-relaxed text-ink-soft">{d.tldr}</p>
        </div>
      )
    }

    <dl class="grid grid-cols-[110px_minmax(0,1fr)] gap-x-5 gap-y-2 border-y border-line py-5 text-[13px]">
      {
        meta.map((m) => (
          <>
            <dt class="text-dim">{m.key}</dt>
            <dd class:list={[m.accent && "text-accent"]}>{m.value}</dd>
          </>
        ))
      }
      {
        links.length > 0 && (
          <>
            <dt class="text-dim">links</dt>
            <dd class="flex flex-wrap gap-4">
              {links.map((l) => (
                <a href={l.href} class="underline underline-offset-3 hover:text-accent">
                  {l.label}
                </a>
              ))}
            </dd>
          </>
        )
      }
    </dl>

    <article class:list={["story", STORY_ON_PAPER && "on-paper"]}>
      <Content />
    </article>

    <nav class="flex flex-wrap justify-between gap-4 border-t border-line pt-6 text-[13px]">
      <a href="/#projects" class="text-dim hover:text-accent">← all projects</a>
      {
        next && (
          <a
            href={projectUrl(next)}
            data-live-accent={projectAccent(next)}
            class="hover:text-accent"
          >
            next: {next.data.title} →
          </a>
        )
      }
    </nav>
  </div>
</BaseLayout>
